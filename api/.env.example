# Copy to .env  (start.sh does it for you and fills in JWT_SECRET).  Never commit .env.
PORT=3220
DATABASE_URL=postgres://localhost/bip_gate

# Signs the access tokens. At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=

# Optional. The Web OAuth client ID(s) from Google Cloud, comma separated. Public identifiers, not secrets.
# Without it, "Sign in with Google" answers 503 and email + password keeps working.
GOOGLE_CLIENT_IDS=

# Optional. Access token lifetime in seconds (default 900 = 15 minutes). Try 30 to watch the refresh happen.
# ACCESS_TOKEN_SECONDS=30

# Optional. Email for the "Forgot password" code. Without it the email is PRINTED in the API log
# (read the newest code with ./code.sh), because your own computer has no mail server.
# A real account, for example:  SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# SMTP_URL=
# MAIL_FROM="The Gate <no-reply@yourdomain.example>"
