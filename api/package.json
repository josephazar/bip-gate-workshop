{
  "name": "bip-gate-api",
  "version": "2.0.0",
  "private": true,
  "description": "The Gate: a user authentication API (email + password, Google, JWT) on Express and PostgreSQL.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "decode": "node scripts/decode-jwt.js",
    "promote": "node --env-file-if-exists=.env scripts/promote.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  }
}
